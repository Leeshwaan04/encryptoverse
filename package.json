{
  "name": "encryptoverse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --port 4173 --strictPort",
    "test:qa": "node tests/audit.mjs http://localhost:4173/",
    "test:security": "node tests/pentest.mjs http://localhost:4173/",
    "test": "npm run test:qa && npm run test:security",
    "data": "node scripts/build-data.mjs",
    "prebuild": "node scripts/ensure-data.mjs",
    "audit:pages": "node scripts/audit-pages.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "4.14.0",
    "oxlint": "^1.81.0",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "8.0.1"
  }
}
